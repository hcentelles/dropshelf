{
  "name": "dropshelf-demo",
  "appName": "Drop Shelf",
  "accountId": "replace-with-your-cloudflare-account-id",
  "bucket": "dropshelf-demo-files",
  "appOrigin": "https://dropshelf-demo.your-subdomain.workers.dev",
  "contentOrigin": "https://dropshelf-demo-content.your-subdomain.workers.dev",
  "transferOrigin": "https://dropshelf-demo-transfer.your-subdomain.workers.dev",
  "accessTeamDomain": "your-team.cloudflareaccess.com",
  "accessAud": "replace-with-your-access-application-audience",
  "maxFileBytes": 104857600,
  "fileRetentionDays": 30,
  "trashRetentionDays": 7,
  "allowedFileTypes": "image/*,.html,.htm,.md,.markdown,.csv,.json,.pdf,.css,.js,.zip",
  "serviceTokenLabels": {}
}
