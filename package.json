{
  "name": "dropshelf",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "A private file shelf for teams, built on Cloudflare Workers, R2, Durable Objects, and Access.",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "vite build",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:web": "npm run test:e2e -- --project=web",
    "test:e2e:mcp": "npm run test:e2e -- --project=mcp",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && playwright test",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@phosphor-icons/web": "^2.1.2",
    "@zip.js/zip.js": "^2.24.0",
    "agents": "^0.31.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  }
}
