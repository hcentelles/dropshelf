{
  "name": "dropshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private file shelf for teams, built on Cloudflare Workers, R2, D1, and Access.",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "vite build",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@phosphor-icons/web": "^2.1.2",
    "agents": "^0.31.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  }
}
